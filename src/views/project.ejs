<%- include('partials/header') %>
<h1><%= project.title %></h1>
<div class="project-details">
    <h2>Description</h2>

    <% if (locals.user && locals.user.role_name === "admin") { %>
        <p>            
            <a href="/edit-project/<%= project.project_id %>">
                Edit Project
            </a>
        </p>
    <% } %>

    <p>
        <%= project.description %>    
    </p>

    <h2>Date</h2>

    <p>
        <%= project.project_date.toLocaleDateString() %>
    </p>

    <h2>Location</h2>

    <p>
        <%= project.location %>
    </p>

    <h2>Partner Organization</h2>

    <p>
        <a href="/organization/<%= project.organization_id %>">
            <%= project.organization_name %>
        </a>
    </p>

    <h2>Categories</h2>

    <div class="category-tags">
        <% categories.forEach(category => { %>
            <a class="category-tag" href="/category/<%= category.category_id %>">
                <%= category.name %>
            </a>
        <% }) %>
    </div>
    
    <% if (user) { %>
        
        <hr>

        <h2>Volunteer</h2>

        <% if (!userIsVolunteer) { %>

            <form action="/project/<%= project.project_id %>/volunteer" method="POST">
                <button type="submit">
                    Volunteer for this Project
                </button>
            </form>

        <% } else { %>

            <p>
                <strong>✓ You are volunteering for this project.</strong>
            </p>

            <form action="/project/<%= project.project_id %>/remove-volunteer" method="POST">
                <button type="submit">
                    Remove Me as a Volunteer
                </button>
            </form>

        <% } %>

    <% } %>

</div>

<% if (user && user.role_name === "admin") { %>
    <a href="/assign-categories/<%= project.project_id %>">
        Edit Categories
    </a>
<% } %>

<p>
    <a href="/projects">
        ← Back to Upcoming Projects
    </a>
</p>

<%- include('partials/footer') %>

