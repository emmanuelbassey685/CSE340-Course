<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <% if (user && user.role_name === "admin") { %>
        <a href="/new-organization" class="button">
            + Add New Organization
        </a>
    <% } %>
    
    <p>Here are a few of our partner organizations:</p>

    <ul>
        <% organizations.forEach(org => { %>
            <li>
                <img src="/images/<%= org.logo_filename %>" alt="<%= org.name %> logo">

                <strong>
                    <a href="/organization/<%= org.organization_id %>">
                        <%= org.name %>
                    </a>
                </strong>

                : <%= org.contact_email %>

                |

                <% if (locals.user && locals.user.role_name === "admin") { %>
                    <a href="/edit-organization/<%= org.organization_id %>">
                        Edit
                    </a>
                <% } %>
                
            </li>
        <% }) %>
    </ul>
</main>

<%- include('partials/footer') %>