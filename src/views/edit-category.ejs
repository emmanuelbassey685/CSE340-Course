<%- include("partials/header") %>

<main>
    <h1>Edit Category</h1>

    <% if (errors.length > 0) { %>
        <ul class="errors">
            <% errors.forEach(error => { %>
                <li><%= error.msg %></li>
            <% }) %>
        </ul>
    <% } %>

    <form action="/edit-category/<%= category.category_id %>" method="POST">

        <label for="name">Category Name</label>

        <input
            type="text"
            id="name"
            name="name"
            maxlength="100"
            required
            value="<%= category.name || '' %>"
        >

        <button type="submit">
            Update Category
        </button>

    </form>

</main>

<%- include("partials/footer") %>