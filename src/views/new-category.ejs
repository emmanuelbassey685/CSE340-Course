<%- include("partials/header") %>

<main>
    <h1>Create New Category</h1>
    
    <% if (errors.length > 0) { %>
        <ul class="errors">
            <% errors.forEach(error => { %>
                <li><%= error.msg %></li>
            <% }) %>
        </ul>
    <% } %>

    <form action="/new-category" method="POST">

        <label for="name">Category Name</label>       

        <input
            type="text"
            id="name"
            name="name"
            maxlength="100"
            required
            autocomplete="off"
            value="<%= category.name || '' %>"
        >

        <button type="submit">
            Create Category
        </button>

    </form>

</main>

<%- include("partials/footer") %>